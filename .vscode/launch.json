{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GT2 (Build + Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/gt2",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-all"
        },
        {
            "name": "Debug GT2 (Debug Only)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/gt2",
            "args": [],
